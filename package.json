{
  "name": "nuvro-ai",
  "private": true,
  "version": "1.2.0",
  "description": "NUVRO AI coding agent: local Ollama, Sarvam, Universal cloud APIs, verified coding tools and secure Windows credentials",
  "author": "NUVRO AI",
  "main": "dist/electron/main.cjs",
  "type": "module",
  "scripts": {
    "test:offline-plugins": "node scripts/smoke/offline-plugins.mjs",
    "test:packaged-debugger": "node scripts/smoke/packaged-debugger-acceptance.mjs",
    "test:packaged-static": "node scripts/smoke/packaged-static-contract.mjs",
    "dev": "cross-env NODE_ENV=development tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/electron/preload.cjs",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:local-qwen": "tsx scripts/smoke/local-qwen.ts",
    "test:live-review-agent": "tsx scripts/smoke/reviewer-agent-live.ts",
    "benchmark:coding": "tsx scripts/smoke/coding-benchmark.ts",
    "test:benchmark-preflight": "node --test scripts/smoke/benchmark-preflight.test.mjs",
    "test:benchmark-contract": "node --test scripts/smoke/coding-benchmark-contract.test.mjs",
    "test:benchmark-artifact-contract": "node --test scripts/smoke/benchmark-artifact-contract.test.mjs",
    "test:benchmark-summary": "tsx --test scripts/smoke/benchmark-summary.test.mjs",
    "test:benchmark-quality": "tsx --test scripts/smoke/benchmark-quality.test.ts",
    "test:benchmark-compare": "node --test scripts/smoke/compare-benchmark.test.mjs",
    "test:package-preflight": "node --test scripts/smoke/package-resource-preflight.test.mjs",
    "test:resource-guard": "tsx scripts/smoke/resource-guard-verify.ts",
    "probe:cpu-window": "node scripts/smoke/cpu-sample-window-probe.mjs",
    "test:nsis-fallback-cleanup": "node --test scripts/smoke/cleanup-incomplete-nsis.test.mjs",
    "benchmark:acceptance": "tsx scripts/smoke/coding-benchmark.ts --acceptance",
    "benchmark:compare": "node scripts/smoke/compare-benchmark.mjs",
    "benchmark:public-reference": "node scripts/smoke/report-public-benchmark.mjs",
    "test:public-benchmark-reference": "node --test scripts/smoke/public-benchmark-reference.test.mjs",
    "benchmark:matrix": "tsx scripts/smoke/ollama-model-matrix.ts",
    "test:benchmark-artifact": "node scripts/smoke/benchmark-artifact-contract.mjs",
    "test:token-efficiency": "vitest run src/server/__tests__/conversationCompaction.test.ts src/server/__tests__/projectRag.test.ts --pool=forks --maxWorkers=1 --isolate=false",
    "benchmark:tavily": "tsx scripts/smoke/tavily-verification-benchmark.ts",
    "demo:tavily": "tsx scripts/smoke/tavily-hackathon-demo.ts",
    "test:live-tavily": "tsx scripts/smoke/live-tavily.ts",
    "test:verification-http": "node scripts/smoke/verification-http.mjs",
    "test:website-behavior": "tsx scripts/smoke/website-behavior-check.ts",
    "test:electron-browser": "electron scripts/smoke/electron-browser-e2e.cjs",
    "test:electron-launch": "node scripts/smoke/electron-launch-contract.cjs",
    "test:fault-policy-live": "node scripts/smoke/fault-policy-live-contract.cjs",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:electron": "npm run build",
    "package:win": "node scripts/smoke/package-win.mjs",
    "test:agent-e2e": "node scripts/e2e/run-agent-e2e.mjs",
    "test:core": "tsx --test scripts/smoke/core.test.mjs",
    "test:backend:e2e": "tsc --project tsconfig.integration.json && node scripts/smoke/http-e2e.mjs",
    "test:resilience": "tsx --test scripts/smoke/agent-resilience.test.mjs",
    "test:sarvam-contract": "cross-env NODE_ENV=test tsx --test scripts/smoke/sarvam-contract.test.mjs",
    "test:tool-parser": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test scripts/smoke/tool-text-parser.test.mjs scripts/smoke/tool-text-safety.test.mjs",
    "test:universal": "node --test scripts/smoke/universal-provider.test.mjs scripts/smoke/universal-settings.test.mjs",
    "test:openai": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test scripts/smoke/openai-provider.test.mjs",
    "test:smoke": "npm run test:openai && npm run test:universal && npm run test:core && npm run test:resilience && npm run test:sarvam-contract && npm run test:tool-parser && npm run test:repair && npm run test:atomic && npm run test:windows-storage-contract && npm run test:benchmark-preflight && npm run test:benchmark-contract && npm run test:benchmark-artifact-contract && npm run test:release-artifact-names && npm run test:source-encoding && npm run test:benchmark-summary && npm run test:benchmark-quality && npm run test:benchmark-compare && npm run test:nsis-fallback-cleanup && npm run test:tavily-demo && npm run test:turbo-global-state && npm run test:turbo-throughput && npm run test:crash-boundary && npm run test:provider-profile-limits && npm run test:provider-health-monitor && npm run test:mission-control && npm run test:rag-incremental && npm run test:approval-batch && npm run test:codebase-qa && npm run test:nim-failover && npm run test:provider-model-failover && npm run test:self-healing && npm run test:ui-accessibility && npm run test:fault-policy-live",
    "test:turbo-throughput": "tsx scripts/smoke/turbo-throughput-benchmark.ts",
    "test:tavily-demo": "node --test scripts/smoke/tavily-hackathon-demo.test.mjs",
    "test:repair": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test scripts/smoke/repair-budget.test.mjs",
    "test:atomic": "tsx --test scripts/smoke/workspace-atomic.test.mjs",
    "test:windows-storage-contract": "tsx --test scripts/smoke/windows-dpapi-contract.test.mjs",
    "check:sarvam-storage": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-sarvam-storage.mjs",
    "test:sarvam-http:e2e": "tsc --project tsconfig.integration.json && node scripts/smoke/sarvam-http-e2e.mjs",
    "test:live-provider": "tsx scripts/smoke/live-provider-check.ts",
    "test:live-provider:saved": "tsx scripts/smoke/live-saved-provider-check.ts",
    "test:live-agent-edit:saved": "tsx scripts/smoke/live-saved-agent-edit.ts",
    "test:live-provider:mock": "node scripts/smoke/live-provider-matrix.mjs",
    "test:release-artifact": "node scripts/smoke/release-artifact-check.mjs",
    "test:release-fingerprint": "node --test scripts/smoke/release-source-fingerprint.test.mjs",
    "test:release-artifact-names": "node --test scripts/smoke/release-artifact-names.test.mjs",
    "test:source-encoding": "node --test scripts/smoke/source-encoding.test.mjs",
    "test:dependency-audit": "node scripts/smoke/dependency-audit.mjs",
    "test:release-signature": "node scripts/smoke/release-signature-check.mjs",
    "test:settings-health": "node scripts/smoke/settings-health-contract.mjs",
    "test:preview-ui": "node scripts/smoke/preview-ui-contract.mjs",
    "test:chat-ui": "node scripts/smoke/chat-ui-contract.mjs",
    "test:turbo-global-state": "node scripts/smoke/turbo-global-state-contract.mjs",
    "test:crash-boundary": "node scripts/smoke/crash-boundary-contract.mjs",
    "test:provider-profile-limits": "node scripts/smoke/provider-profile-limits-contract.mjs",
    "test:provider-health-monitor": "node scripts/smoke/provider-health-monitor-contract.mjs",
    "test:mission-control": "node scripts/smoke/mission-control-contract.mjs",
    "test:rag-incremental": "node scripts/smoke/rag-incremental-contract.mjs",
    "test:approval-batch": "node scripts/smoke/approval-batch-contract.mjs",
    "test:codebase-qa": "node scripts/smoke/codebase-qa-contract.mjs",
    "test:nim-failover": "node scripts/smoke/nim-failover-contract.mjs",
    "test:provider-model-failover": "vitest run --pool=threads --maxWorkers=1 --isolate=false src/server/__tests__/providerModelCatalog.test.ts src/server/__tests__/providerModelFailover.test.ts src/server/__tests__/universalProvider.test.ts",
    "test:self-healing": "node scripts/smoke/self-healing-contract.mjs",
    "test:ui-accessibility": "node scripts/smoke/ui-accessibility-contract.mjs",
    "test:dead-controls": "node scripts/smoke/dead-controls-contract.mjs",
    "test:inline-edit": "node scripts/smoke/inline-edit-contract.mjs",
    "test:auto-test": "node scripts/smoke/auto-test-contract.mjs",
    "test:undo-changeset": "node scripts/smoke/undo-changeset-contract.mjs",
    "test:rate-limit": "node scripts/smoke/rate-limit-contract.mjs",
    "test:memory-hygiene": "node scripts/smoke/memory-hygiene-contract.mjs",
    "test:checkpoints": "node scripts/smoke/checkpoints-contract.mjs",
    "test:prompt-cache": "node scripts/smoke/prompt-cache-contract.mjs",
    "test:large-file": "node scripts/smoke/large-file-contract.mjs",
    "test:tavily-web": "node scripts/smoke/tavily-web-contract.mjs",
    "test:tavily-web:e2e": "node scripts/smoke/tavily-web-http-e2e.mjs",
    "test:tavily-research:e2e": "node scripts/smoke/tavily-research-http-e2e.mjs",
    "test:checkpoints:e2e": "node scripts/smoke/checkpoints-http-e2e.mjs",
    "test:auto-test:e2e": "node scripts/smoke/auto-test-http-e2e.mjs",
    "test:conversation-mode-storage": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test scripts/smoke/conversation-mode-storage.test.mjs",
    "test:production-surface": "node scripts/smoke/production-surface-contract.mjs",
    "test:acceptance:safe": "node scripts/smoke/full-acceptance.mjs",
    "test:acceptance:all": "cross-env QUILLIX_ALLOW_SERVICE_LAUNCH=1 QUILLIX_ALLOW_PACKAGED_LAUNCH=1 node scripts/smoke/full-acceptance.mjs"
  },
  "dependencies": {
    "@babel/parser": "8.0.7",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tavily/core": "^0.7.14",
    "@vitejs/plugin-react": "^6.1.1",
    "diff": "^9.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^0.546.0",
    "monaco-editor": "^0.56.0",
    "motion": "^12.23.24",
    "prettier": "3.9.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "vitest": "^5.0.1"
  }
}
